# Copy to backend/.env when running the backend directly (without Docker).
GEMINI_API_KEY=your-gemini-api-key

# Optional: where Hugging Face caches the text encoder (~20 GB)
# HF_HOME=/path/to/.huggingface_cache

# Optional: override the default model locations (default: ./downloads/)
# GGUF_PATH=/path/to/Wan2.1-T2V-1.3B-Q4_K_M.gguf
# VAE_PATH=/path/to/wan_2.1_vae.safetensors
